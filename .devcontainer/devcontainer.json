{
    "name": "Talk Numba Dev Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--platform=linux/amd64"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "forwardPorts": [8888],
    "postCreateCommand": "micromamba install -y libllvm8 python=3.8 -c conda-forge && micromamba run pip install -r requirements.txt && micromamba clean -a -y",
    "postStartCommand": "nohup bash -c 'micromamba run jupyter notebook --ip=0.0.0.0 --port=8888 --allow-root --NotebookApp.token= &'"
}
